#!/usr/bin/env bash
# prepare-commit-msg: puts the message rules (commit_rules in common.sh) as comments into the editor.
set -uo pipefail
. "$(dirname "$0")/common.sh"

# $2 is empty only for a plain `git commit`; -m/-F, templates, merges, squashes and --amend bring a message.
[ -z "${2:-}" ] || exit 0
{
  echo
  commit_rules | sed 's/^/# /'
  cat "$1"
} >"$1.tmp" && mv "$1.tmp" "$1"
